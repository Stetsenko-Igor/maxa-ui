    "./component-alert.css": "./dist/component-alert.css",
    "./component-avatar.css": "./dist/component-avatar.css",
    "./component-badge.css": "./dist/component-badge.css",
    "./component-breadcrumb.css": "./dist/component-breadcrumb.css",
    "./component-button.css": "./dist/component-button.css",
    "./component-calendar.css": "./dist/component-calendar.css",
    "./component-checkbox.css": "./dist/component-checkbox.css",
    "./component-context-menu.css": "./dist/component-context-menu.css",
