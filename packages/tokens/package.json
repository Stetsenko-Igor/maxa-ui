    "figma:bundle:check": "node ./scripts/build-figma-import-bundle.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "typescript": "*",
    "vitest": "*"
